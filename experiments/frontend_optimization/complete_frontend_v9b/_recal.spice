.meas tran sf_main_150 FIND V(sf_out) AT=0.0255000
.meas tran sf_main_200 FIND V(sf_out) AT=0.0305000
.meas tran sf_main_300 FIND V(sf_out) AT=0.0405000
.meas tran sf_main_400 FIND V(sf_out) AT=0.0505000
.meas tran sf_main_500 FIND V(sf_out) AT=0.0605000
.meas tran sf_main_600 FIND V(sf_out) AT=0.0705000
.meas tran sf_main_700 FIND V(sf_out) AT=0.0805000
.meas tran sf_main_800 FIND V(sf_out) AT=0.0905000
.meas tran sf_main_900 FIND V(sf_out) AT=0.1005000
.meas tran sf_main_1000 FIND V(sf_out) AT=0.1105000
.meas tran sf_main_1500 FIND V(sf_out) AT=0.1605000
.meas tran sf_main_2000 FIND V(sf_out) AT=0.2105000
.meas tran sf_main_2500 FIND V(sf_out) AT=0.2605000
.meas tran sf_main_3000 FIND V(sf_out) AT=0.3105000
.meas tran sf_main_3500 FIND V(sf_out) AT=0.3605000
.meas tran sf_main_4000 FIND V(sf_out) AT=0.4105000
