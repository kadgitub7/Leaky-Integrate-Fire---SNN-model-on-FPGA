.meas tran sf_main_7000 FIND V(sf_out) AT=0.7105000
.meas tran sf_main_8000 FIND V(sf_out) AT=0.8105000
.meas tran sf_fast_5 FIND V(xdt.sf_timer2) AT=0.0110000
.meas tran sf_fast_10 FIND V(xdt.sf_timer2) AT=0.0115000
.meas tran sf_fast_20 FIND V(xdt.sf_timer2) AT=0.0125000
.meas tran sf_fast_30 FIND V(xdt.sf_timer2) AT=0.0135000
