.title delay_timer_calibration
.lib "C:/Users/kadhi/OneDrive/Desktop/amux/verilogLearning/Leaky-Integrate-Fire---SNN-model-on-FPGA/experiments/frontend_optimization/ngspice_frontend/sky130_minimal.lib.spice" tt
.option scale=1.0u method=gear reltol=0.01 gmin=1e-15
.temp 27
Vdd vdd 0 0.9
Vss vss 0 0

.include "C:/Users/kadhi/OneDrive/Desktop/amux/verilogLearning/Leaky-Integrate-Fire---SNN-model-on-FPGA/experiments/frontend_optimization/complete_frontend/inverter.spice"
.include "C:/Users/kadhi/OneDrive/Desktop/amux/verilogLearning/Leaky-Integrate-Fire---SNN-model-on-FPGA/experiments/frontend_optimization/complete_frontend/bias_gen.spice"
.include "C:/Users/kadhi/OneDrive/Desktop/amux/verilogLearning/Leaky-Integrate-Fire---SNN-model-on-FPGA/experiments/frontend_optimization/complete_frontend/delay_timer.spice"

* Use analog bias_gen instead of ideal Vbias
Xbias vbias vref vdd vss bias_gen
.ic V(xbias.iref)=0.3

* rpeak pulse at t=10ms
Vrpk rpeak_pulse 0 PWL(0 0 9.5e-3 0 10.0e-3 0.9 10.5e-3 0.9 11.0e-3 0)

* Dummy thresholds (set very low so comparators don't fire and interfere)
Vth14 vth_14_node 0 0.05
Vth69 vth_69_node 0 0.05
Vth28 vth_28_node 0 0.05
Vth300 vth_300_node 0 0.05
Vth10 vth_10_node 0 0.05

Xdt rpeak_pulse trig_s14 trig_s69 trig_wid trig_bi_copy trig_rr_copy sf_out vdd vss vbias vth_14_node vth_69_node vth_28_node vth_300_node vth_10_node delay_timer

.tran 0.1m 900m
.meas tran sf_main_10 FIND V(sf_out) AT=0.0115000
.meas tran sf_main_20 FIND V(sf_out) AT=0.0125000
.meas tran sf_main_30 FIND V(sf_out) AT=0.0135000
.meas tran sf_main_40 FIND V(sf_out) AT=0.0145000
