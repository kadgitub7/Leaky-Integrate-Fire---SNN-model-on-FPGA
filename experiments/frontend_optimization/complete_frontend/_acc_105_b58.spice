.meas tran ic_bi0_esamp FIND V(xbi0.esamp_node) AT=28.1250000
.meas tran ic_bi1_prev FIND V(xbi1.prev_node) AT=28.1250000
.meas tran ic_bi1_esamp FIND V(xbi1.esamp_node) AT=28.1250000

.end
