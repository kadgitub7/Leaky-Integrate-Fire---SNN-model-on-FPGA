* INITIAL CONDITIONS
* ============================================================
.ic V(xrr.net_timer)=0.9
.ic V(xrr.ewma_node)=0.391913
.ic V(xrr.esamp_node)=0.391913
.ic V(xrr.prev_node)=0.391913
.ic V(net_timer2)=0.9
.ic V(xbi0.prev_node)=0.3
.ic V(xbi0.esamp_node)=0.3
