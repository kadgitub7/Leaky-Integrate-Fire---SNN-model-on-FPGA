Xfe elec_l0_p elec_l0_n elec_l1_p elec_l1_n rpeak_threshold vth_14 vth_69 vth_83 vth_300 vth_10 vth_pw_base vth_pw_peak f1_rr_ratio f2_rr_asym f3_bi_l0 f4_bi_l1 f5_pwave f6_width f7_slope f8_symmetry vdd vss asic_frontend

* Bias generator startup
.ic v(xfe.xbias_gen.vbias) = 0.3
.ic v(xfe.xbias_gen.vref) = 0.3

* IA Lead 0: set internal nodes to VREF so OTA is at operating point
.ic v(xfe.xia_l0.ni_p) = 0.3
.ic v(xfe.xia_l0.ni_n) = 0.3
.ic v(xfe.ecg_amp_l0) = 0.3

* IA Lead 1: same
.ic v(xfe.xia_l1.ni_p) = 0.3
.ic v(xfe.xia_l1.ni_n) = 0.3
.ic v(xfe.ecg_amp_l1) = 0.3

* Timer caps precharged
.ic v(xfe.xrr.net_timer) = 0.9
.ic v(xfe.xdelay.timer_node) = 0.9
.ic v(xfe.xdelay.timer2) = 0.9

* EWMA initial
.ic v(xfe.xrr.ewma_node) = 0.15
.ic v(xfe.xrr.prev_node) = 0.15

.tran 0.5m 5.564 uic

