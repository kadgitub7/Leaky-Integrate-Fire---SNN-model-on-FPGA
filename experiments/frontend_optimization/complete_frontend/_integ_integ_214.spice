* INITIAL CONDITIONS
* ============================================================
.ic V(xrr.net_timer)=0.9
.ic V(xrr.ewma_node)=0.391976
.ic V(xrr.esamp_node)=0.391976
.ic V(xrr.prev_node)=0.391976
.ic V(net_timer2)=0.9
.ic V(xbi0.prev_node)=0.3
.ic V(xbi0.esamp_node)=0.3
.ic V(xbi1.prev_node)=0.3
.ic V(xbi1.esamp_node)=0.3

.tran 0.5m 28.6639 UIC

.meas tran rrc_cmp_3 FIND V(rr_cap_level) AT=3.3922222
.meas tran rrc_cmp2_3 FIND V(rr_cap_level) AT=3.4122222
.meas tran rrc_timer_3 FIND V(rr_timer) AT=3.3922222
.meas tran rrc_ewma_3 FIND V(rr_ewma) AT=3.3922222
.meas tran rrc_thresh_3 FIND V(rrc_threshold) AT=3.3922222
