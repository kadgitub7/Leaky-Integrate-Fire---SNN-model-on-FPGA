.meas tran f8_39 FIND V(f8_symmetry) AT=40.6500000

* IC propagation measurements
.meas tran ic_rr_ewma FIND V(xrr.ewma_node) AT=40.6500000
.meas tran ic_rr_esamp FIND V(xrr.esamp_node) AT=40.6500000
.meas tran ic_rr_prev FIND V(xrr.prev_node) AT=40.6500000
.meas tran ic_bi0_prev FIND V(xbi0.prev_node) AT=40.6500000
.meas tran ic_bi0_esamp FIND V(xbi0.esamp_node) AT=40.6500000
.meas tran ic_bi1_prev FIND V(xbi1.prev_node) AT=40.6500000
.meas tran ic_bi1_esamp FIND V(xbi1.esamp_node) AT=40.6500000

.end
