.meas tran ratio_b3 FIND V(rr_ratio_out) AT=2.4618889
.meas tran asym_b3 FIND V(rr_asym_out) AT=2.4618889
.meas tran timer_b4 FIND V(Xrr.net_timer) AT=3.0868889
.meas tran ratio_b4 FIND V(rr_ratio_out) AT=3.0868889
.meas tran asym_b4 FIND V(rr_asym_out) AT=3.0868889
.meas tran timer_b5 FIND V(Xrr.net_timer) AT=3.6868889
.meas tran ratio_b5 FIND V(rr_ratio_out) AT=3.6868889
.meas tran asym_b5 FIND V(rr_asym_out) AT=3.6868889
.meas tran timer_b6 FIND V(Xrr.net_timer) AT=4.3146667
.meas tran ratio_b6 FIND V(rr_ratio_out) AT=4.3146667
