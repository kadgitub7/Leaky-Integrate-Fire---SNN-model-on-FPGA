.title rr_timing_test
.lib "sky130_minimal.lib.spice" tt
.option scale=1.0u method=gear gmin=1e-15 abstol=1e-15 reltol=0.005
.temp 27
.include "rr_timing.spice"

Vdd vdd 0 0.9
Vss vss 0 0
Vbias vbias 0 0.35
Vrpeak rpeak_trigger 0 PWL(0.0000000 0.000000 0.4990000 0.000000 0.5000000 0.900000 0.5050000 0.900000 0.5060000 0.000000 1.1545556 0.000000 1.1555556 0.900000 1.1605556 0.900000 1.1615556 0.000000 1.8267778 0.000000 1.8277778 0.900000 1.8327778 0.900000 1.8337778 0.000000 2.4628889 0.000000 2.4638889 0.900000 2.4688889 0.900000 2.4698889 0.000000 3.0878889 0.000000 3.0888889 0.900000 3.0938889 0.900000 3.0948889 0.000000 3.6878889 0.000000 3.6888889 0.900000 3.6938889 0.900000 3.6948889 0.000000 4.3156667 0.000000 4.3166667 0.900000 4.3216667 0.900000 4.3226667 0.000000 4.9323333 0.000000 4.9333333 0.900000 4.9383333 0.900000 4.9393333 0.000000 5.5795556 0.000000 5.5805556 0.900000 5.5855556 0.900000 5.5865556 0.000000 6.2351111 0.000000 6.2361111 0.900000 6.2411111 0.900000 6.2421111 0.000000 6.8851111 0.000000 6.8861111 0.900000 6.8911111 0.900000 6.8921111 0.000000 7.5156667 0.000000 7.5166667 0.900000 7.5216667 0.900000 7.5226667 0.000000 8.5166667 0.000000)

Xrr rpeak_trigger rr_ratio_out rr_asym_out vdd vss vbias rr_timing

.tran 0.1m 8.5167

.meas tran timer_b0 FIND V(Xrr.net_timer) AT=0.4980000
.meas tran ratio_b0 FIND V(rr_ratio_out) AT=0.4980000
.meas tran asym_b0 FIND V(rr_asym_out) AT=0.4980000
.meas tran timer_b1 FIND V(Xrr.net_timer) AT=1.1535556
.meas tran ratio_b1 FIND V(rr_ratio_out) AT=1.1535556
.meas tran asym_b1 FIND V(rr_asym_out) AT=1.1535556
.meas tran timer_b2 FIND V(Xrr.net_timer) AT=1.8257778
.meas tran ratio_b2 FIND V(rr_ratio_out) AT=1.8257778
.meas tran asym_b2 FIND V(rr_asym_out) AT=1.8257778
