.meas tran peak_out_l0_pre_b3 FIND V(peak_out_l0) AT=1.995000
.meas tran ecg_in_pre_b3 FIND V(ecg_in) AT=1.995000
.meas tran f_rr_ratio_pre_b4 FIND V(f_rr_ratio) AT=2.595000
.meas tran f_rr_asym_pre_b4 FIND V(f_rr_asym) AT=2.595000
.meas tran f_instab_l0_pre_b4 FIND V(f_instab_l0) AT=2.595000
.meas tran f_instab_l1_pre_b4 FIND V(f_instab_l1) AT=2.595000
.meas tran f_pwave_pre_b4 FIND V(f_pwave) AT=2.595000
.meas tran f_width_pre_b4 FIND V(f_width) AT=2.595000
.meas tran peak_out_l0_pre_b4 FIND V(peak_out_l0) AT=2.595000
.meas tran ecg_in_pre_b4 FIND V(ecg_in) AT=2.595000
.meas tran f_rr_ratio_pre_b5 FIND V(f_rr_ratio) AT=3.495000
.meas tran f_rr_asym_pre_b5 FIND V(f_rr_asym) AT=3.495000
.meas tran f_instab_l0_pre_b5 FIND V(f_instab_l0) AT=3.495000
.meas tran f_instab_l1_pre_b5 FIND V(f_instab_l1) AT=3.495000
