* Diagnostic Round 3: Full 8-Feature Verification
* 6 beats, raised baseline, varied P-wave, asymmetric QRS

.title diag_round3

.lib "sky130_minimal.lib.spice" tt
.option scale=1.0u
.option method=gear
.option gmin=1e-15
.option abstol=1e-15
.option reltol=0.005
.temp 27

.include "ota_5t_subthreshold.spice"
.include "inverter.spice"
.include "resistor_div.spice"
.include "rr_timing.spice"
.include "beat_instability.spice"
.include "pwave_energy.spice"
.include "qrs_width.spice"
.include "slope_ratio.spice"
.include "qrs_symmetry.spice"

Vdd vdd 0 0.9
Vss vss 0 0
Vbias vbias 0 0.35
Vref vref 0 0.45

Vecg ecg_in 0 PWL(0.000000 0.250000 0.349000 0.250000 0.380000 0.330000 0.410000 0.250000 0.459000 0.250000 0.500000 0.750000 0.540000 0.250000 0.965000 0.250000 0.996000 0.280000 1.026000 0.250000 1.075000 0.250000 1.100000 0.550000 1.156000 0.250000 1.833000 0.250000 1.864000 0.370000 1.894000 0.250000 1.943000 0.250000 2.000000 0.800000 2.024000 0.250000 2.453000 0.250000 2.484000 0.300000 2.514000 0.250000 2.563000 0.250000 2.600000 0.500000 2.644000 0.250000 3.361000 0.250000 3.392000 0.400000 3.422000 0.250000 3.471000 0.250000 3.500000 0.850000 3.552000 0.250000 4.037000 0.250000 4.068000 0.290000 4.098000 0.250000 4.147000 0.250000 4.200000 0.600000 4.228000 0.250000 4.700000 0.250000)
Vecg2 ecg_in_l1 0 PWL(0.000000 0.250000 0.349000 0.250000 0.380000 0.330000 0.410000 0.250000 0.459000 0.250000 0.500000 0.750000 0.540000 0.250000 0.965000 0.250000 0.996000 0.280000 1.026000 0.250000 1.075000 0.250000 1.100000 0.550000 1.156000 0.250000 1.833000 0.250000 1.864000 0.370000 1.894000 0.250000 1.943000 0.250000 2.000000 0.800000 2.024000 0.250000 2.453000 0.250000 2.484000 0.300000 2.514000 0.250000 2.563000 0.250000 2.600000 0.500000 2.644000 0.250000 3.361000 0.250000 3.392000 0.400000 3.422000 0.250000 3.471000 0.250000 3.500000 0.850000 3.552000 0.250000 4.037000 0.250000 4.068000 0.290000 4.098000 0.250000 4.147000 0.250000 4.200000 0.600000 4.228000 0.250000 4.700000 0.250000)
Vrpeak rpeak_trigger 0 PWL(0.000000 0.000000 0.499000 0.000000 0.500000 0.900000 0.501000 0.900000 0.502000 0.000000 1.099000 0.000000 1.100000 0.900000 1.101000 0.900000 1.102000 0.000000 1.999000 0.000000 2.000000 0.900000 2.001000 0.900000 2.002000 0.000000 2.599000 0.000000 2.600000 0.900000 2.601000 0.900000 2.602000 0.000000 3.499000 0.000000 3.500000 0.900000 3.501000 0.900000 3.502000 0.000000 4.199000 0.000000 4.200000 0.900000 4.201000 0.900000 4.202000 0.000000 4.700000 0.000000)
Vqrs qrs_gate 0 PWL(0.000000 0.000000 0.454000 0.000000 0.455000 0.900000 0.545000 0.900000 0.546000 0.000000 1.070000 0.000000 1.071000 0.900000 1.161000 0.900000 1.162000 0.000000 1.938000 0.000000 1.939000 0.900000 2.029000 0.900000 2.030000 0.000000 2.558000 0.000000 2.559000 0.900000 2.649000 0.900000 2.650000 0.000000 3.466000 0.000000 3.467000 0.900000 3.557000 0.900000 3.558000 0.000000 4.142000 0.000000 4.143000 0.900000 4.233000 0.900000 4.234000 0.000000 4.700000 0.000000)
Vpwave pwave_gate 0 PWL(0.000000 0.000000 0.309000 0.000000 0.310000 0.900000 0.440000 0.900000 0.441000 0.000000 0.925000 0.000000 0.926000 0.900000 1.056000 0.900000 1.057000 0.000000 1.793000 0.000000 1.794000 0.900000 1.924000 0.900000 1.925000 0.000000 2.413000 0.000000 2.414000 0.900000 2.544000 0.900000 2.545000 0.000000 3.321000 0.000000 3.322000 0.900000 3.452000 0.900000 3.453000 0.000000 3.997000 0.000000 3.998000 0.900000 4.128000 0.900000 4.129000 0.000000 4.700000 0.000000)

* rr_timing: rpeak_trigger rr_ratio_out rr_asym_out vdd vss vbias
Xrr rpeak_trigger f_rr_ratio f_rr_asym vdd vss vbias rr_timing

* beat_instability: ecg_in qrs_gate rpeak_trigger instab_out peak_out vdd vss vbias vref
Xinstab0 ecg_in qrs_gate rpeak_trigger f_instab_l0 peak_out_l0 vdd vss vbias vref beat_instability
Xinstab1 ecg_in_l1 qrs_gate rpeak_trigger f_instab_l1 peak_out_l1 vdd vss vbias vref beat_instability

* pwave_energy: ecg_in pwave_gate rpeak_trigger pw_energy_out vdd vss vbias vref
Xpwave ecg_in_l1 pwave_gate rpeak_trigger f_pwave vdd vss vbias vref pwave_energy

* qrs_width: peak_voltage ecg_in qrs_gate rpeak_trigger width_out vdd vss vbias
Xwidth vref ecg_in qrs_gate rpeak_trigger f_width vdd vss vbias qrs_width

* qrs_symmetry: qrs_onset rpeak_trigger sym_out rise_timer_out fall_timer_out vdd vss vbias
Xsym qrs_gate rpeak_trigger f_sym rise_timer_out fall_timer_out vdd vss vbias qrs_symmetry

* slope_ratio: rise_timer_voltage fall_timer_voltage slope_out vdd vss vbias
Xslope rise_timer_out fall_timer_out f_slope vdd vss vbias slope_ratio

* Seed EWMA for beat_instability (avoids 0V cold start)
.ic V(Xinstab0.ewma_peak)=0.5 V(Xinstab1.ewma_peak)=0.5

.tran 0.1m 4.5

.meas tran f_rr_ratio_pre_b1 FIND V(f_rr_ratio) AT=0.495000
.meas tran f_rr_asym_pre_b1 FIND V(f_rr_asym) AT=0.495000
.meas tran f_instab_l0_pre_b1 FIND V(f_instab_l0) AT=0.495000
.meas tran f_instab_l1_pre_b1 FIND V(f_instab_l1) AT=0.495000
.meas tran f_pwave_pre_b1 FIND V(f_pwave) AT=0.495000
.meas tran f_width_pre_b1 FIND V(f_width) AT=0.495000
.meas tran peak_out_l0_pre_b1 FIND V(peak_out_l0) AT=0.495000
.meas tran ecg_in_pre_b1 FIND V(ecg_in) AT=0.495000
.meas tran f_rr_ratio_pre_b2 FIND V(f_rr_ratio) AT=1.095000
.meas tran f_rr_asym_pre_b2 FIND V(f_rr_asym) AT=1.095000
.meas tran f_instab_l0_pre_b2 FIND V(f_instab_l0) AT=1.095000
