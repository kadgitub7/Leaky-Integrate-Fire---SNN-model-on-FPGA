.meas tran rise_timer_out_late_b6 FIND V(rise_timer_out) AT=4.228000
.meas tran fall_timer_out_late_b6 FIND V(fall_timer_out) AT=4.228000
.meas tran f_sym_late_b6 FIND V(f_sym) AT=4.228000
