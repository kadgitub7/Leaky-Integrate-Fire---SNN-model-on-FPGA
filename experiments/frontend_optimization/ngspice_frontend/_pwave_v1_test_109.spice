* === LPF at 8Hz ===
XM5a taila vbias_lpf vss vss sky130_fd_pr__nfet_01v8 L=8 W=0.42 nf=1
XM1a net1a ecg_l1 taila vss sky130_fd_pr__nfet_01v8 L=4 W=2 nf=1
XM2a lpf8 lpf8 taila vss sky130_fd_pr__nfet_01v8 L=4 W=2 nf=1
XM3a net1a net1a vdd vdd sky130_fd_pr__pfet_01v8 L=4 W=2 nf=1
XM4a lpf8 net1a vdd vdd sky130_fd_pr__pfet_01v8 L=4 W=2 nf=1
XCa lpf8 vss sky130_fd_pr__cap_mim_m3_1 W=71 L=71

* === LPF at 3Hz ===
XM5b tailb vbias_hpf vss vss sky130_fd_pr__nfet_01v8 L=8 W=0.42 nf=1
XM1b net1b ecg_l1 tailb vss sky130_fd_pr__nfet_01v8 L=4 W=2 nf=1
XM2b lpf3 lpf3 tailb vss sky130_fd_pr__nfet_01v8 L=4 W=2 nf=1
XM3b net1b net1b vdd vdd sky130_fd_pr__pfet_01v8 L=4 W=2 nf=1
XM4b lpf3 net1b vdd vdd sky130_fd_pr__pfet_01v8 L=4 W=2 nf=1
XCb lpf3 vss sky130_fd_pr__cap_mim_m3_1 W=71 L=71

* === Subtractor: BPF = LPF8 - LPF3 ===
XM5c tailc vbias_lpf vss vss sky130_fd_pr__nfet_01v8 L=8 W=0.42 nf=1
XM1c net1c lpf8 tailc vss sky130_fd_pr__nfet_01v8 L=1 W=8 nf=1
XM2c bpf_out lpf3 tailc vss sky130_fd_pr__nfet_01v8 L=1 W=8 nf=1
XM3c net1c net1c vdd vdd sky130_fd_pr__pfet_01v8 L=1 W=4 nf=1
XM4c bpf_out bpf_out vdd vdd sky130_fd_pr__pfet_01v8 L=1 W=4 nf=1

* === S&H: captures BPF output during P-wave window ===
* This captures the LAST value before gate closes (at PW_E)
XMsh bpf_out pw_gate peak_out vss sky130_fd_pr__nfet_01v8 L=0.5 W=2 nf=1
XCsh peak_out vss sky130_fd_pr__cap_mim_m3_1 W=32 L=32

