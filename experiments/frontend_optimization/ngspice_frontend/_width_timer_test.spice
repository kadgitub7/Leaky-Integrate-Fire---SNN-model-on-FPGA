.meas tran width_mid_b4 FIND V(width_out) AT=3.7550000
.meas tran width_b5 FIND V(width_out) AT=4.6350000
.meas tran width_mid_b5 FIND V(width_out) AT=4.5650000
.meas tran width_b6 FIND V(width_out) AT=5.4550000
.meas tran width_mid_b6 FIND V(width_out) AT=5.3750000
.meas tran width_b7 FIND V(width_out) AT=6.2750000
.meas tran width_mid_b7 FIND V(width_out) AT=6.1850000
.meas tran width_b8 FIND V(width_out) AT=6.9450000
