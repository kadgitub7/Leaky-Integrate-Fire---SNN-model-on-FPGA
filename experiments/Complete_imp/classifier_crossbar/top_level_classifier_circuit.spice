* =================================================================
* TOP-LEVEL: Complete Analog ECG Classifier
* Architecture: 8 -> 64 -> 5 MLP on ReRAM Crossbar
* Technology: SKY130 (NFET/PFET 01v8 + ReRAM)
* Column readout: real NFET/PFET mirrors (col_readout subcircuit)
* Input conditioning: B-source with V_COL_OFFSET
* =================================================================
*
* L1 scale: 1.4244e+05,  L2 scale: 1.1970e+05
* V_READ: 0.15V,  V_COL_OFFSET: 0.52V,  VDD: 1.8V
* L1 cells: 1024 1T1R,  L2 cells: 640 1T1R
* =================================================================

.include "C:/src/skywater-pdk-libs-sky130_fd_pr/cells/nfet_01v8/sky130_fd_pr__nfet_01v8__tt.corner.spice"
.include "C:/src/skywater-pdk-libs-sky130_fd_pr/cells/nfet_01v8/sky130_fd_pr__nfet_01v8__mismatch.corner.spice"
.include "C:/src/skywater-pdk-libs-sky130_fd_pr/cells/pfet_01v8/sky130_fd_pr__pfet_01v8__tt.corner.spice"
.include "C:/src/skywater-pdk-libs-sky130_fd_pr/cells/pfet_01v8/sky130_fd_pr__pfet_01v8__mismatch.corner.spice"
.param sky130_fd_pr__pfet_01v8__a0_diff = 0
.param sky130_fd_pr__pfet_01v8__agidl_diff = 0
.param sky130_fd_pr__pfet_01v8__ags_diff = 0
.param sky130_fd_pr__pfet_01v8__b0_diff = 0
.param sky130_fd_pr__pfet_01v8__b1_diff = 0
.param sky130_fd_pr__pfet_01v8__bgidl_diff = 0
.param sky130_fd_pr__pfet_01v8__cgidl_diff = 0
.param sky130_fd_pr__pfet_01v8__dlc_diff = 0
.param sky130_fd_pr__pfet_01v8__dwc_diff = 0
.param sky130_fd_pr__pfet_01v8__eta0_diff = 0
.param sky130_fd_pr__pfet_01v8__k2_diff = 0
.param sky130_fd_pr__pfet_01v8__keta_diff = 0
.param sky130_fd_pr__pfet_01v8__kt1_diff = 0
.param sky130_fd_pr__pfet_01v8__ku0_diff = 0
.param sky130_fd_pr__pfet_01v8__kvsat_diff = 0
.param sky130_fd_pr__pfet_01v8__kvth0_diff = 0
.param sky130_fd_pr__pfet_01v8__lint_diff = 0
.param sky130_fd_pr__pfet_01v8__lku0_diff = 0
.param sky130_fd_pr__pfet_01v8__lkvth0_diff = 0
.param sky130_fd_pr__pfet_01v8__nfactor_diff = 0
.param sky130_fd_pr__pfet_01v8__pclm_diff = 0
.param sky130_fd_pr__pfet_01v8__pdits_diff = 0
.param sky130_fd_pr__pfet_01v8__pditsd_diff = 0
.param sky130_fd_pr__pfet_01v8__rdsw_diff = 0
.param sky130_fd_pr__pfet_01v8__tvoff_diff = 0
.param sky130_fd_pr__pfet_01v8__u0_diff = 0
.param sky130_fd_pr__pfet_01v8__ua_diff = 0
.param sky130_fd_pr__pfet_01v8__ub_diff = 0
.param sky130_fd_pr__pfet_01v8__uc_diff = 0
.param sky130_fd_pr__pfet_01v8__ute_diff = 0
.param sky130_fd_pr__pfet_01v8__voff_diff = 0
.param sky130_fd_pr__pfet_01v8__vsat_diff = 0
.param sky130_fd_pr__pfet_01v8__vth0_diff = 0
.param sky130_fd_pr__pfet_01v8__wint_diff = 0
.param sky130_fd_pr__pfet_01v8__wku0_diff = 0
.param sky130_fd_pr__pfet_01v8__wkvth0_diff = 0
.param sky130_fd_pr__pfet_01v8__wlod_diff = 0

* === 1T1R ReRAM cell (SKY130 PDK behavioral I-V) ===
.subckt reram_1t1r row gate col gnd Tf0=3.3e-9
.param Ik1=6.14e-05
.param Tox=5e-09
.param Tfref=4.7249e-09
.param Vref=0.43
Xacc row gate mid gnd sky130_fd_pr__nfet_01v8 W=1.0u L=0.15u
Breram mid col I = Ik1*exp(-(Tox-Tf0)/(Tox-Tfref))*sinh(max(min(v(mid,col)/Vref,30),-30))
.ends reram_1t1r

* === Differential column readout (replaces Vsource + CCCS) ===
.subckt col_readout col_p col_n nmac vdd gnd
Xpd col_p col_p gnd gnd sky130_fd_pr__nfet_01v8 W=50.0u L=1.0u
Xpm nmac col_p gnd gnd sky130_fd_pr__nfet_01v8 W=50.0u L=1.0u
Xnd col_n col_n gnd gnd sky130_fd_pr__nfet_01v8 W=50.0u L=1.0u
Xnm mid_n col_n gnd gnd sky130_fd_pr__nfet_01v8 W=50.0u L=1.0u
Xpcd mid_n mid_n vdd vdd sky130_fd_pr__pfet_01v8 W=50.0u L=1.0u
Xpcm nmac mid_n vdd vdd sky130_fd_pr__pfet_01v8 W=50.0u L=1.0u
.ends col_readout

* ===== SUPPLY =====
VDD vdd 0 1.8

* ===== FEATURE INPUTS =====
Vfeat0 feat0 0 0.0
Vfeat1 feat1 0 0.0
Vfeat2 feat2 0 0.0
Vfeat3 feat3 0 0.0
Vfeat4 feat4 0 0.0
Vfeat5 feat5 0 0.0
Vfeat6 feat6 0 0.0
Vfeat7 feat7 0 0.0

* ===== INPUT CONDITIONING (8 channels) =====
* B-source: V_row = gain*V_feat + offset + V_COL_OFFSET
* gain = V_READ/(8*scale), offset = V_READ*(4-mean/scale)/8
* V_COL_OFFSET = 0.52V compensates NFET diode column voltage

* --- Feature 0 (F1_rr_deviation): mean=-0.001966, scale=0.469741 ---
* gain=3.99155737e-02 V/V, offset_base=7.50784630e-02, +V_COL_OFFSET=0.52
Bcond0 row0 0 V = v(feat0)*3.99155737e-02 + 5.95078463e-01

* --- Feature 1 (F4_bi_L1): mean=-0.000008, scale=0.384009 ---
* gain=4.88270111e-02 V/V, offset_base=7.50003880e-02, +V_COL_OFFSET=0.52
Bcond1 row1 0 V = v(feat1)*4.88270111e-02 + 5.95000388e-01

* --- Feature 2 (F2_rr_asymmetry): mean=-0.000038, scale=0.658086 ---
* gain=2.84917140e-02 V/V, offset_base=7.50010917e-02, +V_COL_OFFSET=0.52
Bcond2 row2 0 V = v(feat2)*2.84917140e-02 + 5.95001092e-01

* --- Feature 3 (F5_pwave_diff): mean=0.013629, scale=0.140897 ---
* gain=1.33076214e-01 V/V, offset_base=7.31862608e-02, +V_COL_OFFSET=0.52
Bcond3 row3 0 V = v(feat3)*1.33076214e-01 + 5.93186261e-01

* --- Feature 4 (F6_width_proxy): mean=-0.573710, scale=0.381370 ---
* gain=4.91648705e-02 V/V, offset_base=1.03206391e-01, +V_COL_OFFSET=0.52
Bcond4 row4 0 V = v(feat4)*4.91648705e-02 + 6.23206391e-01

* --- Feature 5 (F3_bi_L0): mean=0.000029, scale=0.512142 ---
* gain=3.66109250e-02 V/V, offset_base=7.49989512e-02, +V_COL_OFFSET=0.52
Bcond5 row5 0 V = v(feat5)*3.66109250e-02 + 5.94998951e-01

* --- Feature 6 (F7_slope): mean=0.814082, scale=0.743661 ---
* gain=2.52131149e-02 V/V, offset_base=5.44744521e-02, +V_COL_OFFSET=0.52
Bcond6 row6 0 V = v(feat6)*2.52131149e-02 + 5.74474452e-01

* --- Feature 7 (F8_rpeak_voltage): mean=0.901827, scale=0.837629 ---
* gain=2.23846220e-02 V/V, offset_base=5.48129528e-02, +V_COL_OFFSET=0.52
Bcond7 row7 0 V = v(feat7)*2.23846220e-02 + 5.74812953e-01

* ===== LAYER 1: 8x64 DIFFERENTIAL 1T1R ReRAM CROSSBAR =====
Vgate_l1 gate_l1 0 1.8

* --- Positive conductance array ---
Xrpl1_0_0 row0 gate_l1 cpl1_0 0 reram_1t1r Tf0=3.300000e-09  $ G+=0.296uS
