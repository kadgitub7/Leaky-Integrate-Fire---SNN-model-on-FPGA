* V3 detector — no external threshold needed
Xdet ecg_in rpeak_out vdd vss vbias
+ env_fast_raw env_fast env_avg peak_level adapt_thr
+ slope_gate_out thr_gate_out
+ rpeak_detector_v3

.ic v(env_fast_raw)=0.2810 v(env_fast)=0.2810
+ v(env_avg)=0.2810 v(peak_level)=0.2810
+ v(adapt_thr)=0.2810
+ v(xdet.xslope.delayed)=0.2810

.tran 50u 10.0 0 50u

.meas tran det1 when v(rpeak_out)=0.45 rise=1
.meas tran det2 when v(rpeak_out)=0.45 rise=2
.meas tran det3 when v(rpeak_out)=0.45 rise=3
.meas tran det4 when v(rpeak_out)=0.45 rise=4
.meas tran det5 when v(rpeak_out)=0.45 rise=5
.meas tran det6 when v(rpeak_out)=0.45 rise=6
.meas tran det7 when v(rpeak_out)=0.45 rise=7
.meas tran det8 when v(rpeak_out)=0.45 rise=8
.meas tran det9 when v(rpeak_out)=0.45 rise=9
.meas tran det10 when v(rpeak_out)=0.45 rise=10
.meas tran det11 when v(rpeak_out)=0.45 rise=11
.meas tran det12 when v(rpeak_out)=0.45 rise=12
.meas tran det13 when v(rpeak_out)=0.45 rise=13
.meas tran det14 when v(rpeak_out)=0.45 rise=14
.meas tran det15 when v(rpeak_out)=0.45 rise=15
.meas tran det16 when v(rpeak_out)=0.45 rise=16
.meas tran det17 when v(rpeak_out)=0.45 rise=17
.meas tran det18 when v(rpeak_out)=0.45 rise=18
.meas tran det19 when v(rpeak_out)=0.45 rise=19
.meas tran det20 when v(rpeak_out)=0.45 rise=20

.control
set filetype=ascii
run
echo "=== RECORD 105 V3 DONE ==="
quit
.endc
.end
