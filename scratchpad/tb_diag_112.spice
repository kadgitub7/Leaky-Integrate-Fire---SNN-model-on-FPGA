+ env_fast_raw env_fast env_avg peak_level adapt_thr
+ noise_gate_out thr_gate_out
+ rpeak_detector_v3

.ic v(env_fast_raw)=0.3023 v(env_fast)=0.3023
+ v(env_avg)=0.3023 v(peak_level)=0.3023
+ v(adapt_thr)=0.3023

.tran 50u 10.0 0 50u

.meas tran det1 when v(rpeak_out)=0.45 rise=1
.meas tran det2 when v(rpeak_out)=0.45 rise=2
